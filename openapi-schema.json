{
  "openapi": "3.1.0",
  "info": {
    "title": "Tic-Tac-Toe Analysis",
    "version": "0.1.0"
  },
  "paths": {
    "/analyze": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Post Analyze",
        "operationId": "post_analyze",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/next-states": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Post Next States",
        "operationId": "post_next_states",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NextStatesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextStatesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluate": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Post Evaluate",
        "operationId": "post_evaluate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/count-games": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Get Count Games",
        "operationId": "get_count_games",
        "parameters": [
          {
            "name": "board",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^[xo.]{9}$",
              "default": ".........",
              "title": "Board"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountGamesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/bot-move": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Post Bot Move",
        "operationId": "post_bot_move",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BotMoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotMoveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "post": {
        "tags": [
          "stats"
        ],
        "summary": "Post Stats",
        "operationId": "post_stats",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "board": {
            "type": "string",
            "maxLength": 9,
            "minLength": 9,
            "pattern": "^[xo.]{9}$",
            "title": "Board"
          }
        },
        "type": "object",
        "required": [
          "board"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "turn": {
            "type": "string",
            "enum": [
              "x",
              "o"
            ],
            "title": "Turn"
          },
          "winning_line": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winning Line"
          }
        },
        "type": "object",
        "required": [
          "score",
          "turn",
          "winning_line"
        ],
        "title": "AnalyzeResponse"
      },
      "BotMoveRequest": {
        "properties": {
          "board": {
            "type": "string",
            "maxLength": 9,
            "minLength": 9,
            "pattern": "^[xo.]{9}$",
            "title": "Board"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "hard"
            ],
            "title": "Difficulty",
            "default": "easy"
          }
        },
        "type": "object",
        "required": [
          "board"
        ],
        "title": "BotMoveRequest"
      },
      "BotMoveResponse": {
        "properties": {
          "board": {
            "type": "string",
            "title": "Board"
          }
        },
        "type": "object",
        "required": [
          "board"
        ],
        "title": "BotMoveResponse"
      },
      "CountGamesResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "CountGamesResponse"
      },
      "EvaluateRequest": {
        "properties": {
          "board": {
            "type": "string",
            "maxLength": 9,
            "minLength": 9,
            "pattern": "^[xo.]{9}$",
            "title": "Board"
          }
        },
        "type": "object",
        "required": [
          "board"
        ],
        "title": "EvaluateRequest"
      },
      "EvaluateResponse": {
        "properties": {
          "value": {
            "type": "integer",
            "title": "Value"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "value",
          "outcome"
        ],
        "title": "EvaluateResponse"
      },
      "GameResultIn": {
        "properties": {
          "winner": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "x",
                  "o"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "hard"
            ],
            "title": "Difficulty"
          }
        },
        "type": "object",
        "required": [
          "winner",
          "difficulty"
        ],
        "title": "GameResultIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NextStatesRequest": {
        "properties": {
          "board": {
            "type": "string",
            "maxLength": 9,
            "minLength": 9,
            "pattern": "^[xo.]{9}$",
            "title": "Board"
          }
        },
        "type": "object",
        "required": [
          "board"
        ],
        "title": "NextStatesRequest"
      },
      "NextStatesResponse": {
        "properties": {
          "next_states": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next States"
          }
        },
        "type": "object",
        "required": [
          "next_states"
        ],
        "title": "NextStatesResponse"
      },
      "StatsRequest": {
        "properties": {
          "games": {
            "items": {
              "$ref": "#/components/schemas/GameResultIn"
            },
            "type": "array",
            "title": "Games"
          }
        },
        "type": "object",
        "required": [
          "games"
        ],
        "title": "StatsRequest"
      },
      "StatsResponse": {
        "properties": {
          "x_wins": {
            "type": "integer",
            "title": "X Wins"
          },
          "o_wins": {
            "type": "integer",
            "title": "O Wins"
          },
          "draws": {
            "type": "integer",
            "title": "Draws"
          },
          "hard_win_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hard Win Rate"
          },
          "easy_win_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Easy Win Rate"
          },
          "hard_bot_unbeaten": {
            "type": "boolean",
            "title": "Hard Bot Unbeaten"
          }
        },
        "type": "object",
        "required": [
          "x_wins",
          "o_wins",
          "draws",
          "hard_win_rate",
          "easy_win_rate",
          "hard_bot_unbeaten"
        ],
        "title": "StatsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
